---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
---
<Base title="CV" description="Alberto Vega's CV">
  <header class="page-header">
    <h1>CV</h1>
    <p class="lead">
      Bachelor's in Software Engineering, specializing in games. Two shipped game projects and two years of game testing.
    </p>
    <div class="actions">
      <a class="button" href={site.cv} download><Icon name="download" size={18} /> Download PDF</a>
      <a class="button ghost" href={site.cv} target="_blank" rel="noopener">Open in new tab <Icon name="external" size={16} /></a>
    </div>
  </header>

  <object class="pdf" data={site.cv} type="application/pdf" aria-label="CV (PDF)">
    <p class="empty">Your browser can't show the PDF here. <a href={site.cv}>Download it instead.</a></p>
  </object>
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .pdf {
    width: 100%;
    height: 80vh;
    min-height: 500px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  @media (max-width: 640px) {
    .pdf {
      display: none;
    }
  }
</style>
