---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

// Every photo in src/assets/food shows up here. Order: the list below first, then any new ones by name.
const files = import.meta.glob<{ default: ImageMetadata }>('../assets/food/*.{jpg,jpeg,png,webp}', { eager: true });
const order = [
  'sundried-hummus-tahini', 'indian-dish', 'banana-truffle', 'oni-giri', 'potato-dumpling', 'sushi-tempura',
  'yeastless-focaccia', 'gnocchi-shrimp', 'siu-mai', 'fish-soup', 'chicken-pasta', 'shrimp-pasta',
  'sandwich-3', 'sandwich-2', 'lentil-burger', 'steak-salad', 'fancy-1', 'duck-rice',
  'devil-eggs', 'xmas', 'marbled-delights',
];
const photos = Object.entries(files)
  .map(([path, mod]) => {
    const name = path.split('/').pop()!.replace(/\.\w+$/, '');
    return { name, img: mod.default, label: name.replace(/-/g, ' ') };
  })
  .filter((p) => !p.name.endsWith('-make'))
  .sort((a, b) => {
    const ia = order.indexOf(a.name), ib = order.indexOf(b.name);
    return (ia < 0 ? 999 : ia) - (ib < 0 ? 999 : ib) || a.name.localeCompare(b.name);
  });

const others = [
  { title: 'Manga', text: 'What I am reading and have read.', href: 'https://www.mangaupdates.com/mylist.html?id=20832&list=read', icon: 'book' },
  { title: 'Streaming', text: 'Catch me live on Twitch.', href: 'https://www.twitch.tv/kiraxxiii', icon: 'twitch' },
  { title: 'Instagram', text: 'Food, dance and everything else.', href: 'https://www.instagram.com/kkiraxxiii/', icon: 'instagram' },
];
---
<Base title="Hobbies" description="Cooking, manga, streaming and more">
  <header class="page-header">
    <h1>Hobbies</h1>
    <p class="lead">Cooking, manga, streaming, music and sports.</p>
  </header>

  <div class="grid">
    {others.map((o) => (
      <a class="card other" href={o.href} target="_blank" rel="noopener">
        <Icon name={o.icon} size={22} />
        <div>
          <h3>{o.title}</h3>
          <p>{o.text}</p>
        </div>
      </a>
    ))}
  </div>

  <h2 id="food">A spice of nom</h2>
  <p class="lead">The dishes that taught, and teach me, how to cook.</p>
  <div class="gallery">
    {photos.map((p) => (
      <figure>
        <Image src={p.img} alt={p.label} width={480} height={480} fit="cover" />
        <figcaption>{p.label}</figcaption>
      </figure>
    ))}
  </div>
</Base>

<style>
  .other {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .other svg {
    color: var(--accent);
    flex: none;
    margin-top: 0.2rem;
  }
  .gallery {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(45%, 220px), 1fr));
  }
  figure {
    margin: 0;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }
  figure img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  figure:hover img {
    transform: scale(1.04);
  }
  figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 1.5rem 0.75rem 0.5rem;
    background: linear-gradient(transparent, rgb(0 0 0 / 65%));
    color: #fff;
    font-size: 0.85rem;
    text-transform: capitalize;
  }
</style>
