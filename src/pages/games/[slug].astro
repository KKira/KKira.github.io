---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const games = await getCollection('games');
  return games.map((game) => ({ params: { slug: game.id }, props: { game } }));
}

const { game } = Astro.props;
const { Content } = await render(game);
const d = game.data;
const isEmbed = d.trailer?.startsWith('https://');
---
<Base title={d.title} description={d.summary}>
  <p class="back"><a href="/games">← All games</a></p>
  <header class="page-header">
    <h1>{d.title}</h1>
    {d.platform && <p class="lead">{d.platform}</p>}
  </header>

  <div class="layout">
    <div class="media">
      {d.trailer ? (
        isEmbed ? (
          <iframe src={d.trailer} title={`${d.title} trailer`} allowfullscreen loading="lazy" />
        ) : (
          <video controls preload="metadata" src={d.trailer} />
        )
      ) : d.cover ? (
        <Image src={d.cover} alt={d.title} width={800} />
      ) : null}
    </div>

    <div class="prose">
      <Content />

      {d.team.length > 0 && (
        <>
          <h2>Team</h2>
          <ul>{d.team.map((m) => <li>{m}</li>)}</ul>
        </>
      )}

      <div class="actions">
        {d.play && <a class="button" href={d.play} target="_blank" rel="noopener">Play</a>}
        {d.download && (
          <a class="button" href={d.download} target="_blank" rel="noopener">
            <Icon name="download" size={18} /> Download demo
          </a>
        )}
      </div>
    </div>
  </div>
</Base>

<style>
  .back {
    margin: 2rem 0 0;
  }
  .back a {
    text-decoration: none;
  }
  .page-header {
    padding-top: 1rem;
  }
  .layout {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
    }
  }
  .media :is(video, img, iframe) {
    width: 100%;
    border-radius: var(--radius);
    display: block;
  }
  .media iframe {
    aspect-ratio: 16 / 9;
    border: 0;
  }
  .prose :first-child {
    margin-top: 0;
  }
  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }
</style>
