---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';

export async function getStaticPaths() {
  const entries = (await getCollection('journal')).sort((a, b) => a.data.order - b.data.order);
  return entries.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: entries[i - 1], next: entries[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---
<Base title={d.title} description={d.summary}>
  <p class="back"><a href="/journal">← Journal</a></p>
  <article class="prose">
    <header class="page-header">
      <p class="num">Entry {d.order}{d.series && ` · ${d.series}`}</p>
      <h1>{d.title}</h1>
    </header>

    {(d.video || d.objectives) && (
      <div class="intro">
        {d.video && <Video src={d.video} title={`${d.title} demo`} preload="none" />}
        {d.objectives && <Image src={d.objectives} alt="Objectives for this entry" width={700} />}
      </div>
    )}

    <Content />
  </article>

  <nav class="pager" aria-label="Journal entries">
    {prev ? <a href={`/journal/${prev.id}`}>← {prev.data.title}</a> : <span />}
    {next && <a href={`/journal/${next.id}`}>{next.data.title} →</a>}
  </nav>
</Base>

<style>
  .back {
    margin: 2rem 0 0;
  }
  .back a {
    text-decoration: none;
  }
  .page-header {
    padding-top: 1rem;
  }
  .num {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    max-width: 70ch;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
</style>
