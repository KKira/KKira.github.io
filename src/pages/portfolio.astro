---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const games = (await getCollection('games')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Portfolio" description="Projects and code by Alberto Vega">
  <header class="page-header">
    <h1>Portfolio</h1>
    <p class="lead">Things I have built. Games have <a href="/games">their own page</a>.</p>
  </header>

  <h2>Games</h2>
  <div class="grid">
    {games.map((g) => (
      <a class="card" href={`/games/${g.id}`}>
        <h3>{g.data.title}</h3>
        <p>{g.data.summary}</p>
        <ul class="tags">{g.data.tags.map((t) => <li>{t}</li>)}</ul>
      </a>
    ))}
  </div>

  <h2>Projects</h2>
  <div class="grid">
    {projects.map((p) => (
      <article class="card">
        <h3>{p.data.link ? <a href={p.data.link}>{p.data.title}</a> : p.data.title}</h3>
        <p>{p.data.summary}</p>
        <ul class="tags">{p.data.tags.map((t) => <li>{t}</li>)}</ul>
        {p.data.repo && (
          <a class="repo" href={p.data.repo} target="_blank" rel="noopener">
            <Icon name="github" size={16} /> Code
          </a>
        )}
      </article>
    ))}
  </div>
</Base>

<style>
  .card h3 a {
    color: inherit;
  }
  .repo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
    font-size: 0.9rem;
  }
</style>
